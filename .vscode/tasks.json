{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Stop existing app ports",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$ports = @(3001, 5173); foreach ($port in $ports) { $owners = Get-NetTCPConnection -State Listen -LocalPort $port -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique; foreach ($owner in $owners) { if ($owner -ne $PID) { Stop-Process -Id $owner -Force -ErrorAction Stop; Write-Output \"Stopped process $owner on port $port\" } } }"
      ],
      "problemMatcher": []
    },
    {
      "label": "Start PostgreSQL",
      "type": "process",
      "command": "docker",
      "args": ["compose", "up", "-d", "--wait", "db"],
      "problemMatcher": []
    },
    {
      "label": "Build API",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "build:api"],
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Prepare API",
      "dependsOn": ["Start PostgreSQL", "Build API"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Start Vite",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev:web"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "endsPattern": "VITE .* ready in .*"
        }
      }
    }
  ]
}
